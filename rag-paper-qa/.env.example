# Copy this file to .env and fill in the values.
# Pinecone upload is optional; the pipeline works fully locally without it.

PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-paper-qa
# Optional, only used when creating a new index:
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Required for answer generation (RAG "G" stage):
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY
# Optional, defaults to gemini-3.5-flash:
GEMINI_MODEL=gemini-3.5-flash
